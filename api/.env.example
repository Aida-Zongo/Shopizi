# ===========================================
# Shopizi API - Environment Configuration
# ===========================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://shopizi_user:shopizi_pass@localhost:5432/shopizi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=shopizi
DB_USER=shopizi_user
DB_PASSWORD=shopizi_pass

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal API Key (for Python generator)
INTERNAL_API_KEY=change-me-internal-api-key

# SMTP (Email)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@shopizi.bf
SMTP_PASS=change-me-smtp-password
EMAIL_FROM_NAME=Shopizi
EMAIL_FROM_ADDRESS=noreply@shopizi.bf

# CinetPay (Mobile Money Payment Gateway)
CINETPAY_API_KEY=change-me-cinetpay-api-key
CINETPAY_SITE_ID=change-me-cinetpay-site-id
CINETPAY_SECRET=change-me-cinetpay-secret
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_NOTIFY_URL=https://api.shopizi.bf/api/v1/payments/webhook/cinetpay
CINETPAY_RETURN_URL=https://app.shopizi.bf/dashboard/subscription

# Orange Money Direct (fallback)
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
ORANGE_MONEY_BASE_URL=

# Moov Money Direct (fallback)
MOOV_MONEY_API_KEY=
MOOV_MONEY_MERCHANT_ID=
MOOV_MONEY_BASE_URL=

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Site Generator
SITE_OUTPUT_ROOT=/var/www/shops
GENERATOR_PYTHON_PATH=python
GENERATOR_MODULE=generator

# CORS
CORS_ORIGIN=http://localhost:5173,https://app.shopizi.bf

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend URLs (for email links)
FRONTEND_URL=http://localhost:5173
APP_URL=https://app.shopizi.bf

# Google Gemini AI (Assistant Shopping IA)
# Obtenez votre clé gratuite sur : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here